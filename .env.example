# cognibrain configuration
# Copy to .env only when you need to override defaults.

# API server
PORT=8787
NODE_ENV=development
HOST=127.0.0.1
VITE_PORT=5173
VITE_API_URL=http://localhost:8787

# Local persistence. Use jsonl or sqlite for durable local/team pilots.
MEMORY_DB_PATH=.memory-harness.json
MEMORY_STORAGE_BACKEND=json
MEMORY_EVENT_LOG_PATH=.memory-harness.jsonl
MEMORY_SQLITE_PATH=.memory-harness.sqlite

# Automatic maintenance
MEMORY_AUTO_DREAM=true
MEMORY_DREAM_INTERVAL_HOURS=6
MEMORY_DREAM_WRITE_THRESHOLD=12
MEMORY_DREAM_CHECK_INTERVAL_MINUTES=15

# Security. Set these before exposing the API beyond localhost.
MEMORY_REQUIRE_AUTH=false
MEMORY_API_KEYS=
MEMORY_REDACTION_MODE=redact
MEMORY_ENCRYPTION_KEY=
MEMORY_ENCRYPTION_KEY_ID=local
MEMORY_ENCRYPTION_KEY_VERSION=1

# Remote Postgres/Cockroach production path.
MEMORY_POSTGRES_URL=
MEMORY_PSQL_COMMAND=psql
MEMORY_STORAGE_REPLICATION_MODE=logical
MEMORY_STORAGE_SHARDS=1

# Publish/production readiness checks.
MEMORY_DEPLOYMENT_MODE=local
MEMORY_PUBLIC_URL=http://localhost:8787
MEMORY_TLS_TERMINATED_BY=
MEMORY_BACKUP_REF=
MEMORY_SSO_PROVIDER=
MEMORY_SECRET_MANAGER=

# Connector policy defaults for host applications.
MEMORY_DEFAULT_USER_ID=local
MEMORY_DEFAULT_TOKEN_BUDGET=900
MEMORY_NEVER_STORE_SECRETS=true
MEMORY_CONNECTOR_TIMEOUT_MS=10000
MEMORY_WEBHOOK_TIMEOUT_MS=10000

# Built-in external vendor connectors. Use least-privilege bot or app tokens.
MEMORY_GITHUB_REPO=
MEMORY_GITHUB_TOKEN=
MEMORY_GITHUB_API_BASE=https://api.github.com
MEMORY_SLACK_TOKEN=
MEMORY_SLACK_CHANNEL_ID=
MEMORY_SLACK_API_BASE=https://slack.com/api
MEMORY_DISCORD_BOT_TOKEN=
MEMORY_DISCORD_CHANNEL_ID=
MEMORY_DISCORD_API_BASE=https://discord.com/api/v10
