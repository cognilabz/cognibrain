{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognibrain.local/schemas/evidence-pack.schema.json",
  "title": "EvidencePack",
  "type": "object",
  "required": ["schemaVersion", "id", "generatedAt", "query", "userId", "tokenBudget", "context", "results", "summary"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^ctx_" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "query": { "type": "string" },
    "userId": { "type": "string" },
    "actor": { "type": "object", "additionalProperties": true },
    "scope": { "type": "object", "additionalProperties": true },
    "queryIntent": { "type": "object", "additionalProperties": true },
    "tokenBudget": { "type": "number" },
    "hash": { "type": "string" },
    "context": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["memoryId", "content", "source", "scope", "consent", "beliefState", "provenance", "validity", "retrieval"],
        "properties": {
          "memoryId": { "type": "string" },
          "content": { "type": "string" },
          "source": { "type": "object" },
          "scope": { "type": "object" },
          "consent": { "type": "object" },
          "beliefState": { "type": "string" },
          "provenance": { "type": "object" },
          "validity": { "type": "object" },
          "policyDecision": { "type": "object" },
          "contradictionWarnings": { "type": "array", "items": { "type": "string" } },
          "retrieval": {
            "type": "object",
            "required": ["score", "signals", "explanation", "whyIncluded", "whyNotExcluded", "graphPaths", "citation"],
            "properties": {
              "score": { "type": "number" },
              "confidence": { "type": "number" },
              "unsafeToInject": { "type": "boolean" },
              "signals": { "type": "object" },
              "scoreBreakdown": { "type": "object" },
              "explanation": { "type": "array", "items": { "type": "string" } },
              "whyIncluded": { "type": "array", "items": { "type": "string" } },
              "whyNotExcluded": { "type": "array", "items": { "type": "string" } },
              "graphPaths": { "type": "array", "items": { "type": "string" } },
              "citation": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "excludedResults": { "type": "array" },
    "policyDecisions": { "type": "array" },
    "graphPaths": { "type": "array" },
    "temporalState": { "type": "object" },
    "summary": { "type": "object" }
  },
  "additionalProperties": true
}
