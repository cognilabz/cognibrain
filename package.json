{
  "name": "@cognilabz/cognibrain",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Self-hosted engineering memory for coding agents with a stable operator CLI, connectors and benchmark proof.",
  "bin": {
    "cognibrain": "./bin/cognibrain.mjs",
    "cognibrain-connect": "./bin/cognibrain-connect.mjs"
  },
  "exports": {
    ".": "./sdk/typescript/index.ts",
    "./sdk/typescript": "./sdk/typescript/index.ts",
    "./sdk/typescript/client": "./sdk/typescript/client.ts",
    "./sdk/typescript/connectors": "./sdk/typescript/connectors.ts",
    "./sdk/typescript/harness": "./sdk/typescript/harness.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "scripts/",
    "sdk/python/README.md",
    "sdk/python/cognibrain_client.py",
    "sdk/python/pyproject.toml",
    "sdk/python/examples/",
    "sdk/python/tests/test_cognibrain_client.py",
    "sdk/typescript/",
    "src/",
    "fixtures/",
    "templates/",
    "docs/",
    "docker/",
    "deploy/",
    ".env.example",
    "bootstrap.sh",
    "CONTRIBUTING.md",
    "Makefile",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "tsx src/api/server.ts",
    "dashboard": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:check": "node scripts/release/release-check.mjs",
    "release:certify": "npm run internal -- certify:production",
    "verify": "npm run test && npm run internal -- eval && npm run build",
    "verify:ci": "npm run internal -- verify:nextgen",
    "verify:selfhosted": "npm run internal -- verify:selfhosted",
    "proof": "node bin/cognibrain.mjs proof",
    "cli": "tsx src/cli/memctl.ts",
    "mcp": "tsx src/connectors/mcpServer.ts",
    "doctor": "node bin/cognibrain.mjs doctor",
    "setup": "node bin/cognibrain.mjs setup",
    "connect": "node bin/cognibrain-connect.mjs",
    "clean": "node bin/cognibrain.mjs clean",
    "start": "node bin/cognibrain.mjs start",
    "stop": "node bin/cognibrain.mjs stop",
    "status": "node bin/cognibrain.mjs status",
    "skill:install": "node bin/cognibrain.mjs skill install",
    "internal": "node scripts/internal/run-task.mjs"
  },
  "keywords": [
    "memory",
    "agents",
    "cognilabz",
    "cognibrain",
    "coding-harness",
    "retrieval",
    "agent-memory",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.6",
    "vite": "^8.0.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
