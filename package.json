{
  "name": "@cognilabz/cognibrain",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Self-hosted engineering memory for coding agents with an Ink CLI, connectors and benchmark proof.",
  "bin": {
    "cognibrain": "./bin/cognibrain.mjs",
    "cognibrain-connect": "./bin/cognibrain-connect.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "sdk/python/README.md",
    "sdk/python/cognibrain_client.py",
    "sdk/python/pyproject.toml",
    "sdk/python/examples/",
    "sdk/python/tests/test_cognibrain_client.py",
    "src/",
    "fixtures/",
    "artifacts/arena/run.json",
    "artifacts/arena/native-competitors.json",
    "artifacts/connector-maturity.json",
    "artifacts/product-truth-audit.json",
    "artifacts/vendor-api-specs.json",
    "artifacts/vendor-live-smoke.json",
    "templates/",
    "docs/",
    "public/benchmark-arena/",
    "public/leaderboard/",
    "docker/",
    "deploy/",
    ".env.example",
    "bootstrap.sh",
    "CONTRIBUTING.md",
    "Makefile",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "tsx src/api/server.ts",
    "dashboard": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx src/eval/run.ts",
    "eval:nextgen": "tsx src/eval/nextgen.ts --out artifacts/nextgen-eval.json",
    "benchmark:locomo": "tsx src/eval/locomo.ts",
    "benchmark:longmemeval": "tsx src/eval/longmemeval.ts",
    "benchmark:beam": "tsx src/eval/beam.ts",
    "benchmark:nextgen": "tsx src/eval/nextgenBenchmarks.ts --out artifacts/nextgen-benchmarks.json",
    "benchmark:cognicode:generate": "tsx src/eval/cognicodeBench.ts --generate-only --count 100 --scenarios-out artifacts/cognicodebench/scenarios.json --out artifacts/cognicodebench/generate-report.json",
    "benchmark:cognicode": "tsx src/eval/cognicodeBench.ts --count 100 --scenarios-out artifacts/cognicodebench/scenarios.json --out artifacts/cognicodebench/run.json",
    "benchmark:arena": "node scripts/benchmark-native-competitors.mjs",
    "benchmark:arena:run": "tsx src/eval/arena.ts --systems cognibrain,mem0,graphiti,cognee,langmem,gbrain --benchmark cognicode --out artifacts/arena/run.json",
    "benchmark:arena:publish": "tsx src/eval/publishArena.ts --input artifacts/arena/run.json --out public/benchmark-arena --markdown docs/benchmarks/latest-arena.md",
    "benchmark:competitors:native": "node scripts/benchmark-native-competitors.mjs",
    "demo:first-win": "node scripts/demo-first-win.mjs",
    "demo:why-used": "node scripts/demo-proof.mjs --why-used",
    "demo:cognicodebench": "node scripts/demo-proof.mjs --cognicode",
    "demo:github-review": "node scripts/demo-proof.mjs --github-review",
    "demo:proof": "node scripts/demo-proof.mjs",
    "leaderboard": "tsx src/eval/leaderboard.ts --out artifacts/leaderboard.json",
    "benchmark:beam:500k": "tsx src/eval/beam.ts --split 500K --top-k 20 --out artifacts/beam-500k-report.json",
    "benchmark:market": "tsx src/eval/marketGate.ts",
    "benchmark:answer-generation": "tsx src/eval/answerGeneration.ts --out artifacts/answer-generation.json",
    "benchmark:load": "tsx src/eval/load.ts --out artifacts/load-benchmark.json",
    "verify:postgres": "tsx src/eval/postgresLive.ts --out artifacts/postgres-live.json",
    "verify:connectors": "tsx src/eval/connectorsLive.ts --out artifacts/connectors-live.json",
    "verify:vendor-connectors": "tsx src/eval/vendorConnectorsLive.ts --out artifacts/vendor-connectors-live.json",
    "verify:vendor-api-specs": "tsx src/eval/vendorApiSpecs.ts --input artifacts/vendor-connectors-live.json --out artifacts/vendor-api-specs.json",
    "verify:vendor-live": "tsx src/eval/vendorCredentialSmoke.ts --out artifacts/vendor-live-smoke.json",
    "verify:compatibility": "npm run verify:connectors && npm run verify:vendor-connectors && npm run verify:vendor-api-specs && npm run verify:vendor-live",
    "connectors:maturity": "tsx src/eval/connectorMaturity.ts --out artifacts/connector-maturity.json --markdown docs/integrations/connector-maturity.md",
    "benchmark:certified": "tsx src/eval/certified.ts",
    "leaderboard:publish": "tsx src/eval/publishLeaderboard.ts --input artifacts/leaderboard.json --out public/leaderboard && npm run benchmark:arena:publish",
    "docs:cli-screenshots": "node scripts/render-cli-screenshots.mjs",
    "verify:status": "node scripts/verify-status.mjs",
    "verify:selfhosted:claims": "node scripts/verify-selfhosted.mjs",
    "audit:docs": "node scripts/audit-docs.mjs",
    "audit:truth": "node scripts/audit-product-truth.mjs",
    "release:check": "node scripts/release-check.mjs",
    "verify": "npm run test && npm run eval && npm run build",
    "verify:nextgen": "npm run test && npm run eval && npm run eval:nextgen && npm run benchmark:nextgen && npm run benchmark:cognicode && npm run benchmark:arena && npm run demo:first-win && npm run benchmark:answer-generation -- --reports artifacts/nextgen-benchmarks.json,artifacts/cognicodebench/run.json && npm run leaderboard && npm run verify:compatibility && npm run connectors:maturity && npm run verify:status && npm run audit:docs && npm run audit:truth && npm run build",
    "verify:selfhosted": "npm run verify:nextgen && npm run verify:postgres && npm run verify:selfhosted:claims && npm run doctor:publish && npm pack --dry-run && python3 -m unittest discover -s sdk/python/tests",
    "cli": "tsx src/cli/memctl.ts",
    "mcp": "tsx src/connectors/mcpServer.ts",
    "doctor": "node bin/cognibrain.mjs doctor",
    "doctor:publish": "node bin/cognibrain.mjs doctor --publish",
    "setup": "node bin/cognibrain.mjs setup",
    "setup:selfhosted": "node bin/cognibrain.mjs setup --self-hosted",
    "connect": "node bin/cognibrain-connect.mjs",
    "clean": "node bin/cognibrain.mjs clean",
    "start:local": "node scripts/start-local.mjs",
    "start:daemon": "node scripts/start-local.mjs --daemon",
    "stop:local": "node scripts/start-local.mjs --stop",
    "status:local": "node scripts/start-local.mjs --status",
    "install:codex-skill": "node scripts/install-codex-skill.mjs"
  },
  "keywords": [
    "memory",
    "agents",
    "cognilabz",
    "cognibrain",
    "coding-harness",
    "retrieval",
    "agent-memory",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vitejs/plugin-react": "^6.0.2",
    "ink": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.6",
    "vite": "^8.0.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
